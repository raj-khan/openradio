# Optional: pin a Radio Browser mirror instead of resolving one automatically
RADIO_BROWSER_BASE_URL=

# Optional: enables AI understanding on /discover (Vercel AI Gateway)
AI_GATEWAY_API_KEY=
# Optional: model used for discovery, provider/model format
AI_MODEL=openai/gpt-5-mini

# Public site origin, used for metadata, sitemap and robots
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: privacy-friendly visit counting with GoatCounter (no cookies, no personal data)
# Example: https://openradio.goatcounter.com
NEXT_PUBLIC_GOATCOUNTER_URL=

# Optional: Google Analytics 4. Sets cookies, so it asks the visitor first and
# stores nothing until they agree. Leave blank to keep analytics off entirely.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
